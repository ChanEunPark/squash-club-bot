[Unit]
Description=Squash Club Discord Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/squash-club-bot
EnvironmentFile=/home/admin/squash-club-bot/.env
ExecStart=/usr/bin/node /home/admin/squash-club-bot/bot.mjs
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/admin/squash-club-bot/data

[Install]
WantedBy=multi-user.target
